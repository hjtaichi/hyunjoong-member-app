{
  "expo": {
    "name": "현중태극권",
    "slug": "member-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "memberapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071A39",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.anonymous.memberapp",
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/images/icon.png"
    },
    "web": {
      "output": "static",
      "favicon": "./public/icon.png",
      "name": "현중태극권",
      "shortName": "현중태극권",
      "backgroundColor": "#071A39",
      "themeColor": "#071A39",
      "display": "standalone",
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#071A39"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#071A39",
          "imageWidth": 300,
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "contain",
            "imageWidth": 300,
            "backgroundColor": "#071A39"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-font",
      "expo-video",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c499655c-6543-4f41-834d-85283ceced26"
      }
    },
    "owner": "superjulia"
  }
}
